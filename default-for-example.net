version = "v1"

[loader.review]
required = false

[key-manager]
ds-algorithm = "SHA-256"
auto-remove = true

[key-manager.ksk]
validity = "31536000"
auto-start = true
auto-report = true
auto-expire = true
auto-done = true

[key-manager.zsk]
validity = "7776000"
auto-start = true
auto-report = true
auto-expire = true
auto-done = true

[key-manager.csk]
validity = "forever"
auto-start = true
auto-report = true
auto-expire = true
auto-done = true

[key-manager.algorithm]
auto-start = true
auto-report = true
auto-expire = true
auto-done = true

[key-manager.records]
ttl = 3600

[key-manager.records.dnskey]
signature-inception-offset = 3600
signature-lifetime = 1209600
signature-remain-time = 259200

[key-manager.records.cds]
signature-inception-offset = 3600
signature-lifetime = 1209600
signature-remain-time = 259200

[key-manager.generation]
hsm-server-id = "TODO"
use-csk = false
algorithm = "RSASHA256"

[signer]
serial-policy = "unix-time"
signature-inception-offset = 0
signature-lifetime = 0
signature-remain-time = 0

[signer.denial]
type = "nsec"

[signer.review]
required = false

[server.outbound]
accept-xfr-requests-from = []

[[server.outbound.send-notify-to]]
addr = "1.2.3.5:53"
