<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <RepositoryList>
    <Repository name="somehsm">
      <Module>/path/to/some/pkcs11/module.so</Module>
      <TokenLabel>OpenDNSSEC</TokenLabel>
      <PIN>1234</PIN>
    </Repository>
  </RepositoryList>
  <Common>
    <PolicyFile>kasp.xml</PolicyFile>
    <ZoneListFile>zonelist.xml</ZoneListFile>
  </Common>
  <Enforcer>
    <Datastore>
      <Test>db.ron</Test>
    </Datastore>
    <!-- Set an empty working directory to override the default /var/opendnssec/tmp -->
    <WorkingDirectory />
    <!-- Interval was removed in 2.x -->
    <Interval>PT3600S</Interval>
  </Enforcer>
</Configuration>
