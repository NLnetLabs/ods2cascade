<?xml version="1.0" encoding="utf-8"?>
<KASP>
  <Policy name="bcp-compliant-nsec3-settings">
    <Description>A policy with NSEC3 settings conforming to BCP 236/RFC 9276</Description>
    <Signatures>
      <Resign>PT2H</Resign>
      <Refresh>P3D</Refresh>
      <Validity>
        <Default>P14D</Default>
        <Denial>P14D</Denial>
      </Validity>
      <Jitter>PT12H</Jitter>
      <InceptionOffset>PT3600S</InceptionOffset>
    </Signatures>
    <Denial>
      <NSEC3>
        <Resalt>PT1D</Resalt>
        <Hash>
          <Algorithm>8</Algorithm>
          <Iterations>0</Iterations>
          <Salt length="0"/>
        </Hash>
      </NSEC3>
    </Denial>
    <Keys>
      <TTL>PT3600S</TTL>
      <RetireSafety>PT3600S</RetireSafety>
      <PublishSafety>PT3600S</PublishSafety>
      <CSK>
        <Algorithm length="2048">8</Algorithm>
        <Lifetime>P1Y</Lifetime>
        <Repository>somehsm</Repository>
      </CSK>
    </Keys>
    <Zone>
      <PropagationDelay>PT43200S</PropagationDelay>
      <SOA>
        <TTL>PT3600S</TTL>
        <Minimum>PT3600S</Minimum>
        <Serial>unixtime</Serial>
      </SOA>
    </Zone>
    <Parent>
      <PropagationDelay>PT9999S</PropagationDelay>
      <DS>
        <TTL>PT3600S</TTL>
      </DS>
      <SOA>
        <TTL>PT172800S</TTL>
        <Minimum>PT10800S</Minimum>
      </SOA>
    </Parent>
  </Policy>

