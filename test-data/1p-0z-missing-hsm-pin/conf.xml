<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <RepositoryList>
    <Repository name="somehsm">
      <Module>/path/to/some/pkcs11/module.so</Module>
      <TokenLabel>SomeTokenLabel</TokenLabel>
      <!-- No <PIN/> -->
    </Repository>
  </RepositoryList>
  <Common>
    <PolicyFile>kasp.xml</PolicyFile>
    <ZoneListFile>zonelist.xml</ZoneListFile>
  </Common>
  <Enforcer>
    <Datastore>
      <SQLite>kasp.db</SQLite>
    </Datastore>
    <!-- Set an empty working directory to override the default /var/opendnssec/tmp -->
    <WorkingDirectory />
  </Enforcer>
</Configuration>
